# Standalone WebSocket relay for handhold. Deployed to Fly.io.
FROM node:22-alpine AS deps
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
# Install ONLY the runtime deps the relay needs.
RUN pnpm install --prod --frozen-lockfile --filter . --ignore-scripts

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8080
COPY --from=deps /app/node_modules ./node_modules
COPY relay ./relay
COPY lib ./lib
COPY tsconfig.json ./
EXPOSE 8080
CMD ["node", "--experimental-strip-types", "--no-warnings", "relay/server.ts"]
